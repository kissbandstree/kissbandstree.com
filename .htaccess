
RewriteEngine on
DirectorySlash Off

# Redirect www → non-www (http or https)
RewriteCond %{HTTP_HOST} ^www\.kissbandstree\.com$ [NC]
RewriteRule ^(.*)$ https://kissbandstree.com/$1 [R=301,L]

# Redirect http → https (non-www)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteRule ^(.*)$ https://kissbandstree.com/$1 [R=301,L]

# Route public pages and old implementation URLs before rendering any content.
RewriteRule ^(index|calendar|about|thanks|stats|tree|(bands|artists|releases_band|releases_related)_(grid|table|list))\.php$ page.php [L]
RewriteRule ^(bands|artists|releases|related|calendar|about|thanks|stats|tree)/?$ page.php [L]
RewriteRule ^$ page.php [L]
